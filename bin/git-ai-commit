#!/usr/bin/env bash
# git-ai-commit: AI-assisted conventional git commit generator using local Ollama (Qwen 1.5B)
set -eo pipefail

OLLAMA_URL="http://127.0.0.1:11434"
MODEL="qwen2.5:1.5b"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_BLUE="\033[1;34m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"

# Verify git repo
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${C_RED}Error:${C_RESET} Not inside a git repository."
    exit 1
fi

# Check staged changes
staged_diff=$(git diff --cached)
if [[ -z "$staged_diff" ]]; then
    if [[ -n $(git status --porcelain) ]]; then
        echo -e "${C_YELLOW}No staged changes detected.${C_RESET}"
        read -r -p "Stage all modified files (git add -A)? [Y/n] " answer
        answer=${answer:-Y}
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            git add -A
            staged_diff=$(git diff --cached)
        else
            echo "Aborted. Stage changes with 'git add' and re-run."
            exit 0
        fi
    else
        echo -e "${C_GREEN}Working tree clean.${C_RESET} Nothing to commit."
        exit 0
    fi
fi

# Check Ollama status
if ! curl -s --connect-timeout 1 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; then
    echo -e "${C_RED}Error:${C_RESET} Local Ollama is not running at $OLLAMA_URL."
    exit 1
fi

generate_message() {
    local temp="${1:-0.1}"
    local stat_summary
    stat_summary=$(git diff --cached --stat | head -n 15)
    local diff_text
    diff_text=$(git diff --cached | head -c 4500)

    local payload
    payload=$(jq -n \
        --arg model "$MODEL" \
        --arg stat "$stat_summary" \
        --arg diff "$diff_text" \
        --argjson temp "$temp" \
        '{
            model: $model,
            messages: [
                {
                    role: "system",
                    content: "You are a Git commit message generator. Generate a single-line conventional commit message summarizing the changes (format: type(scope): description, e.g. feat: ..., fix: ..., refactor: ..., docs: ...). Output ONLY the message text on a single line. Do not include markdown code blocks, explanations, or quotes."
                },
                {
                    role: "user",
                    content: ("Files modified:\n" + $stat + "\n\nDiff:\n" + $diff)
                }
            ],
            stream: false,
            options: {
                temperature: $temp,
                num_predict: 40
            }
        }')

    local res
    res=$(curl -s -X POST "$OLLAMA_URL/api/chat" \
        -H "Content-Type: application/json" \
        -d "$payload")

    local msg
    msg=$(echo "$res" | jq -r '.message.content // empty' | tr -d '`' | sed 's/^["]*//;s/["]*$//' | head -n 1)
    echo "$msg"
}

echo -e "${C_CYAN}Analyzing staged diff with local AI ($MODEL)...${C_RESET}"
commit_msg=$(generate_message 0.1)

if [[ -z "$commit_msg" ]]; then
    echo -e "${C_RED}Could not generate commit message.${C_RESET}"
    exit 1
fi

while true; do
    echo ""
    echo -e "${C_BLUE}╭─────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_BLUE}│${C_RESET} ${C_BOLD}Proposed Commit Message:${C_RESET}"
    echo -e "${C_BLUE}│${C_RESET} ${C_GREEN}${commit_msg}${C_RESET}"
    echo -e "${C_BLUE}╰─────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e " ${C_BOLD}[c]${C_RESET} Commit  ${C_BOLD}[e]${C_RESET} Edit  ${C_BOLD}[r]${C_RESET} Regenerate  ${C_BOLD}[a]${C_RESET} Abort"
    read -r -p "Select option [c/e/r/a]: " choice
    choice=${choice:-c}

    case "$choice" in
        c|C|"")
            git commit -m "$commit_msg"
            echo -e "${C_GREEN}✔ Committed successfully!${C_RESET}"
            break
            ;;
        e|E)
            read -r -e -i "$commit_msg" -p "Edit message: " user_edited
            if [[ -n "$user_edited" ]]; then
                git commit -m "$user_edited"
                echo -e "${C_GREEN}✔ Committed successfully!${C_RESET}"
            else
                echo -e "${C_YELLOW}Empty message. Aborted.${C_RESET}"
            fi
            break
            ;;
        r|R)
            echo -e "${C_CYAN}Regenerating with alternative wording...${C_RESET}"
            commit_msg=$(generate_message 0.7)
            ;;
        a|A|q|Q)
            echo -e "${C_YELLOW}Commit aborted.${C_RESET}"
            exit 0
            ;;
        *)
            echo -e "${C_RED}Invalid option.${C_RESET}"
            ;;
    esac
done
