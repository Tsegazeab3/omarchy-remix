#!/usr/bin/env bash
# screen-watch: watches external displays and notifies when one drops or reconnects.
# Logs every event to ~/.local/state/screen-watch.log
#   Start:  screen-watch &        Stop:  pkill -f screen-watch
#   Report: screen-watch --report

LOG="$HOME/.local/state/screen-watch.log"
mkdir -p "$(dirname "$LOG")"

if [[ "$1" == "--report" ]]; then
  [[ -f "$LOG" ]] || { echo "No events logged yet."; exit 0; }
  echo "Drops logged:      $(grep -c 'DISCONNECTED' "$LOG")"
  echo "Reconnects logged: $(grep -c 'RECONNECTED' "$LOG")"
  echo "Kernel warnings:   $(grep -c 'KERNEL' "$LOG")"
  echo "--- last 15 events ---"; tail -n 15 "$LOG"
  exit 0
fi

# Only one watcher at a time
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/screen-watch.lock"
flock -n 9 || { echo "screen-watch is already running."; exit 0; }

last_notify=0
log() {  # $1 = level, $2 = message
  echo "$(date '+%F %T') $1 $2" >>"$LOG"
  local now; now=$(date +%s)
  # Rate-limit popups to one every 10s so heavy flicker doesn't spam you
  if (( now - last_notify >= 10 )); then
    local urgency=normal; [[ "$1" == DISCONNECTED || "$1" == KERNEL ]] && urgency=critical
    notify-send -u "$urgency" -a "Screen watch" "Screen: $1" "$2"
    last_notify=$now
  fi
}

log STARTED "Watching displays: $(hyprctl monitors -j | python3 -c 'import sys,json;print(", ".join(m["name"]+" "+m["description"] for m in json.load(sys.stdin)))')"

# 1) Hyprland hotplug events (screen lost/regained by the compositor)
sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
socat -U - UNIX-CONNECT:"$sock" | while IFS= read -r line; do
  case "$line" in
    monitorremoved\>\>*) log DISCONNECTED "Display ${line#*>>} lost signal / unplugged" ;;
    monitoradded\>\>*)   log RECONNECTED  "Display ${line#*>>} is back" ;;
  esac
done &

# 2) Kernel display-link errors (signal problems that may not trigger a hotplug)
journalctl -k -f -n 0 -o short-iso 2>/dev/null \
  | grep --line-buffered -iE 'i915.*(link train|fifo underrun|hotplug|hpd|DP-[0-9]|HDMI|failed|error)' \
  | while IFS= read -r line; do log KERNEL "${line#* }"; done &

# 3) Raw connector status as a fallback (polls every 2s)
declare -A prev
while true; do
  for f in /sys/class/drm/card*-DP-*/status /sys/class/drm/card*-HDMI-*/status; do
    [[ -e "$f" ]] || continue
    name=$(basename "$(dirname "$f")"); s=$(<"$f")
    if [[ -n "${prev[$name]}" && "${prev[$name]}" != "$s" ]]; then
      [[ "$s" == connected ]] && log RECONNECTED "$name connector: connected" \
                              || log DISCONNECTED "$name connector: $s"
    fi
    prev[$name]=$s
  done
  sleep 2
done
